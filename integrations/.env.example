# Salvare la configurazione effettiva fuori dal repository e indicarla con TREC_AUTH_ENV.
OIDC_ISSUER=http://localhost:3000
OIDC_CLIENT_ID=trec-demo
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3004/callback
OIDC_RESOURCE=http://localhost:3000/trec-api

# Facoltativo: leggere ID e chiave del Verifier dal vecchio .env, senza copiarli qui.
ORIGINAL_VERIFIER_ENV=
VERIFIER_WALLET_ID=
VERIFIER_WALLET_KEY=
VERIFIER_DID=
# Facoltativo, solo per un wallet SQLite esistente in posizione non standard.
VERIFIER_WALLET_PATH=
CREDENTIAL_DEFINITION_ID=
CHEQD_NETWORK=testnet
CHEQD_RPC_URL=https://rpc.cheqd.network

# Deve essere raggiungibile dal dispositivo del wallet che scansiona il QR.
# Per un telefono usare IP LAN o dominio raggiungibile, NON localhost.
VERIFIER_ENDPOINT=http://localhost:3001
VERIFIER_PORT=3001
PROOF_TIMEOUT_SECONDS=180
OIDC_BIND_HOST=127.0.0.1
CLIENT_BIND_HOST=127.0.0.1
