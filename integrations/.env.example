# Configurazione privata del server.
#
# DID, Schema, Credential Definition, wallet ID, rete,
# endpoint e configurazione OIDC pubblica sono già definiti in:
#
# integrations/config/testnet.json

# Obbligatori
VERIFIER_WALLET_KEY=
OIDC_CLIENT_SECRET=

# Opzionali
OIDC_COOKIE_SECRET=
VERIFIER_WALLET_PATH=

# Override di rete/deployment facoltativi.
# Non sono operazioni di provisioning.
#
# VERIFIER_ENDPOINT=http://192.168.0.101:3001
# VERIFIER_PORT=3001
# OIDC_BIND_HOST=127.0.0.1
# CLIENT_BIND_HOST=127.0.0.1
